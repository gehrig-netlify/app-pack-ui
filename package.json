{
  "name": "@netlify-labs/app-pack-ui",
  "version": "0.1.0",
  "description": "Shared UI components for Netlify's App Packs program.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:js": "tsup",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "build": "npm run build:js && npm run build:css",
    "dev": "concurrently \"tsup --watch\" \"tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch\"",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "ladle:serve": "ladle serve",
    "ladle:build": "ladle build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "zod": "^3.24.0 || ^4.0.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-table": "9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.7",
    "react-error-boundary": "^6.1.4",
    "react-hook-form": "^7.87.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@ladle/react": "^5.1.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^10.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "zod": "^4.5.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
